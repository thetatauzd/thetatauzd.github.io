{
  "rules": {
    "users": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'regent' || root.child('users').child(auth.uid).child('role').val() === 'standards')",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && ((auth.uid === $uid && (!data.exists() || data.child('role').val() === 'pending')) || root.child('users').child(auth.uid).child('role').val() === 'admin')"
      }
    },
    "sessionByCode": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'standards' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
      }
    },
    "sessions": {
      "$sessionId": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'standards' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'standards' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
        },
        "currentPollIndex": {
          ".read": "auth != null",
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'standards' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
        },
        "pollOrder": {
          ".read": "auth != null",
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'standards' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
        },
        "polls": {
          ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'standards' || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'regent')",
          "$pollId": {
            ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'standards' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
            "name":         { ".read": "auth != null" },
            "type":         { ".read": "auth != null" },
            "candidates":   { ".read": "auth != null" },
            "options":      { ".read": "auth != null" },
            "rosterIndex":  { ".read": "auth != null" },
            "useRoster":    { ".read": "auth != null" },
            "threshold":    { ".read": "auth != null" },
            "minimumScore": { ".read": "auth != null" },
            "status":       { ".read": "auth != null" },
            "votes": {
              ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'standards' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
              "$voteUid": {
                ".read": "auth != null && auth.uid === $voteUid",
                ".write": "auth != null && auth.uid === $voteUid && root.child('users').child(auth.uid).child('role').val() !== 'pending'"
              }
            },
            "hasVoted": {
              ".read": "auth != null",
              "$uid": {
                ".write": "auth != null && auth.uid === $uid"
              }
            },
            "progress": {
              ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'regent' || root.child('users').child(auth.uid).child('role').val() === 'standards' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
              "$uid": {
                ".write": "auth != null && auth.uid === $uid"
              }
            },
            "aggregation": {
              ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'regent' || root.child('users').child(auth.uid).child('role').val() === 'standards' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
              ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'standards' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
            }
          }
        },
        "roster": {
          ".read": "auth != null",
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'standards' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
        },
        "connectedBrothers": {
          ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'regent' || root.child('users').child(auth.uid).child('role').val() === 'standards' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'standards' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    },
    "sessionHistory": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'standards' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
    },
    "timers": {
      "active": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'rush_chair')"
      }
    },
    "newsletters": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$id": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    },
    "site": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "rush": {
        "isOpen":          { ".validate": "newData.isBoolean()" },
        "nextSemester":    { ".validate": "newData.isString() && newData.val().length <= 60" },
        "rushTitle":       { ".validate": "newData.isString() && newData.val().length <= 80" },
        "subtitle":        { ".validate": "newData.isString() && newData.val().length <= 200" },
        "ctaLine":         { ".validate": "newData.isString() && newData.val().length <= 200" },
        "rushLinkUrl":     { ".validate": "newData.isString() && newData.val().length <= 500 && (newData.val() === '' || newData.val().beginsWith('https://'))" },
        "interestFormUrl": { ".validate": "newData.isString() && newData.val().length <= 500 && (newData.val() === '' || newData.val().beginsWith('https://'))" },
        "heroImage":       { ".validate": "newData.isString() && newData.val().length <= 200000 && (newData.val() === '' || newData.val().beginsWith('data:image/jpeg;base64,'))" },
        "heroAlt":         { ".validate": "newData.isString() && newData.val().length <= 200" },
        "updatedAt":       { ".validate": "newData.isString() && newData.val().length <= 40" },
        "updatedBy":       { ".validate": "newData.isString() && newData.val().length <= 120" },
        "events": {
          "$i": {
            "title":      { ".validate": "newData.isString() && newData.val().length <= 80" },
            "detail":     { ".validate": "newData.isString() && newData.val().length <= 160" },
            "inviteOnly": { ".validate": "newData.isBoolean()" },
            "image":      { ".validate": "newData.isString() && newData.val().length <= 200000 && (newData.val() === '' || newData.val().beginsWith('data:image/jpeg;base64,'))" },
            "$other":     { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
