      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('perms').child('standards').val() === true || root.child('users').child(auth.uid).child('perms').child('attendance').val() === true || root.child('users').child(auth.uid).child('perms').child('finance').val() === true || root.child('users').child(auth.uid).child('perms').child('settings').val() === true)",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$id": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin' && !data.exists()"
        }
      }
    },
    "portalLinks": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() !== 'pending'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    }
  }
}